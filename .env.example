# College Digital Voting System - Environment Configuration Example
# Copy this file to .env and configure for your deployment.

# Server Port & Host Configuration
PORT=8080
HOST=0.0.0.0

# Database Configuration (Leave MONGODB_URI empty to use the built-in local document store)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
DB_NAME=college_voting_system

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026

# Security & Expiration
SECRET_KEY=scsvmv_digital_voting_system_secret_key_2026
OTP_EXPIRY_MINUTES=5

# SMTP Email Configuration for Real OTP Delivery
# Standard Port Guidance: 587 for STARTTLS (recommended), 465 for SSL, 25 for local relays
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-college-email@example.com
SMTP_PASSWORD=your-secure-app-password
SMTP_FROM_EMAIL=no-reply@kanchiuniv.ac.in
